+import { ReactiveFramework } from "../util/reactiveFramework";
+import { atom, computed, react, transact } from "@tldraw/state";
+
+let toCleanup: (() => void)[] = [];
+export const tldrawStateFramework: ReactiveFramework = {
+  name: "@tldraw/state",
+  signal: (initialValue) => {
+    const a = atom("s", initialValue);
+    return {
+      write: (v) => a.set(v),
+      read: () => a.get(),
+    };
+  },
+  computed: (fn) => {
+    const c = computed("c", fn);
+    return {
+      read: () => c.get(),
+    };
+  },
+  effect: (fn) => toCleanup.push(react("e", fn)),
+  withBatch: (fn) => transact(fn),
+  withBuild: (fn) => fn(),
+  cleanup: () => {
+    for (const cleanup of toCleanup) {
+      cleanup();
+    }
+    toCleanup = [];
+  },
+};
