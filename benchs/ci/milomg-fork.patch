diff --git a/packages/core/src/frameworks/anod.ts b/packages/core/src/frameworks/anod.ts
new file mode 100644
index 0000000..827de8e
--- /dev/null
+++ b/packages/core/src/frameworks/anod.ts
@@ -0,0 +1,66 @@
+import { ReactiveFramework } from "../util/reactiveFramework";
+import {
+  c,
+  OPT_DEFER,
+  root,
+  signal,
+  batch,
+  Reader,
+  Root,
+  RootContext,
+} from "anod";
+
+// anod has no automatic dependency tracking: reads subscribe by calling
+// c.val() on the context passed to each compute/effect callback. Track the
+// innermost context here so wrapped signals can read through it.
+let currentReader: Reader | null = null;
+let currentRoot: RootContext | null = null;
+let rootHandle: Root | null = null;
+
+function tracked<T>(fn: () => T): (c: Reader) => T {
+  return (c) => {
+    const prev = currentReader;
+    currentReader = c;
+    try {
+      return fn();
+    } finally {
+      currentReader = prev;
+    }
+  };
+}
+
+export const anodFramework: ReactiveFramework = {
+  name: "anod",
+  signal: (initialValue) => {
+    const s = signal(initialValue);
+    return {
+      write: (v) => s.set(v),
+      read: () => (currentReader ? currentReader.val(s) : s.get()),
+    };
+  },
+  computed: <T>(fn: () => T) => {
+    const node = (currentRoot ?? c).compute(
+      tracked(fn),
+      undefined as unknown as T,
+      OPT_DEFER,
+    );
+    return {
+      read: () => (currentReader ? currentReader.val(node) : node.get()),
+    };
+  },
+  effect: (fn) => (currentRoot ?? c).effect(tracked(fn)),
+  withBatch: (fn) => batch(fn),
+  withBuild: <T>(fn: () => T) => {
+    let out!: T;
+    rootHandle = root((c) => {
+      currentRoot = c;
+      out = fn();
+    });
+    return out;
+  },
+  cleanup: () => {
+    rootHandle?.dispose();
+    rootHandle = null;
+    currentRoot = null;
+  },
+};
diff --git a/packages/core/src/frameworks/cosignal.ts b/packages/core/src/frameworks/cosignal.ts
new file mode 100644
index 0000000..dcd011c
--- /dev/null
+++ b/packages/core/src/frameworks/cosignal.ts
@@ -0,0 +1,50 @@
+import * as lib from "cosignal";
+import { ReactiveFramework } from "../util/reactiveFramework";
+
+// cosignal v1 DIRECT build, routed through the public class API (Atom /
+// Computed `.state` and `.set`) so the benchmark measures the surface
+// applications use, policy wrapper included. Graphs are built inside an
+// effectScope and disposed in cleanup(), like the other adapters.
+let scope: (() => void) | null = null;
+
+export const cosignalFramework: ReactiveFramework = {
+  name: "Cosignal",
+  signal: <T>(initial: T) => {
+    const a = new lib.Atom(initial);
+    return {
+      read: () => a.state,
+      write: (v: T) => a.set(v),
+    };
+  },
+  computed: <T>(fn: () => T) => {
+    const c = new lib.Computed(fn);
+    return {
+      read: () => c.state,
+    };
+  },
+  // Wrapped so bench callbacks' return values are never treated as cleanup
+  // functions (same shape as the alien-signals adapters).
+  effect: (fn) => {
+    lib.effect(() => {
+      fn();
+    });
+  },
+  withBatch: (fn) => {
+    lib.startBatch();
+    fn();
+    lib.endBatch();
+  },
+  withBuild: <T>(fn: () => T) => {
+    let out!: T;
+    scope = lib.effectScope(() => {
+      out = fn();
+    });
+    return out;
+  },
+  cleanup: () => {
+    if (scope !== null) {
+      scope();
+      scope = null;
+    }
+  },
+};
diff --git a/packages/core/src/frameworks/dalienSignals.ts b/packages/core/src/frameworks/dalienSignals.ts
new file mode 100644
index 0000000..c33dc14
--- /dev/null
+++ b/packages/core/src/frameworks/dalienSignals.ts
@@ -0,0 +1,60 @@
+import { createReactiveSystem } from "dalien-signals/system";
+import { ReactiveFramework } from "../util/reactiveFramework";
+
+// cleanup() calls the library's reset(): bulk arena teardown that rewinds
+// the record plane and drops the whole FinalizationRegistry, so a test's
+// abandoned nodes are reclaimed by the GC as a few large objects instead
+// of one weak cell per handle processed in later tests' timed regions.
+// This is the published generation-scoped lifecycle of the
+// dalien-signals/system interface, and it mirrors what fully GC-managed
+// graphs (alien-signals and friends) get automatically when a dead graph
+// becomes unreachable. 2^21 records = 64 MB of lazily-mapped virtual
+// address space, several times the largest suite test.
+const sys = createReactiveSystem({ initialRecords: 1 << 21 });
+let scope: (() => void) | null = null;
+
+export const dalienFramework: ReactiveFramework = {
+  name: "Dalien Signals",
+  signal: <T>(initial: T) => {
+    const data = sys.makeSignal(initial) as {
+      (): T;
+      (value: T): void;
+    };
+    return {
+      read: () => data(),
+      write: (v: T) => data(v),
+    };
+  },
+  computed: <T>(fn: () => T) => {
+    const c = sys.makeComputed(fn as (previousValue?: unknown) => unknown) as () => T;
+    return {
+      read: () => c(),
+    };
+  },
+  // alien-signals >= 3.2 treats a non-undefined return value from the effect
+  // callback as a cleanup function; the bench contract ignores returns.
+  effect: (fn) => {
+    sys.makeEffect(() => {
+      fn();
+    });
+  },
+  withBatch: (fn) => {
+    sys.startBatch();
+    fn();
+    sys.endBatch();
+  },
+  withBuild: <T>(fn: () => T) => {
+    let out!: T;
+    scope = sys.makeScope(() => {
+      out = fn();
+    });
+    return out;
+  },
+  cleanup: () => {
+    if (scope !== null) {
+      scope();
+      scope = null;
+    }
+    sys.reset();
+  },
+};
